# ---------------------------------------------------------------------
# 1. REDIS DISTRIBUTED CACHING (PHASE 1 - CORE CACHING LAYER)
# ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=seika_redis_secret

# ---------------------------------------------------------------------
# 2. SERVICE DISCOVERY & CONFIGURATION MANAGEMENT
# ---------------------------------------------------------------------
# EUREKA_SERVER_URL: Địa chỉ Eureka Registry để các microservice đăng ký
EUREKA_SERVER_URL=http://eureka:8761/eureka/
# CONFIG_SERVER_URL: Địa chỉ Spring Cloud Config Server
CONFIG_SERVER_URL=http://config-service:8888
CONFIG_SERVER_PORT=8888

# ---------------------------------------------------------------------
# 3. API GATEWAY & SECURITY (JWT AUTHENTICATION & AUTHORIZATION)
# ---------------------------------------------------------------------
GATEWAY_PORT=8080
# JWT_SECRET: Khóa bí mật SHA-256 (tối thiểu 256 bits/64 ký tự hex) dùng ký và xác thực token
JWT_SECRET=8db8d4987f6a51ed76090464c02e06205d68fc0b8d8f024e6c3c57cb67da7a9b
JWT_ISSUER=seika-identity-service
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ---------------------------------------------------------------------
# 4. INITIAL ADMIN ACCOUNT (SYSTEM SEEDING)
# ---------------------------------------------------------------------
ADMIN_INITIAL_ENABLED=true
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=seika123

# ---------------------------------------------------------------------
# 5. RABBITMQ EVENT BUS (ASYNC MESSAGING & CACHE EVICTION)
# ---------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Cấu hình Exchange & Routing cho sự kiện người dùng
IDENTITY_EVENTS_EXCHANGE=identity.events
USER_REGISTERED_ROUTING_KEY=user.registered
USER_REGISTERED_QUEUE=notification.user-events

# ---------------------------------------------------------------------
# 6. RELATIONAL DATABASES - POSTGRESQL (LOCAL DOCKER vs CLOUD)
# ---------------------------------------------------------------------
# --- Identity Service ---
# [Cloud Supabase Template]
# IDENTITY_DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# IDENTITY_DB_USERNAME=postgres.username
# IDENTITY_DB_PASSWORD=cloud_password
IDENTITY_DB_URL=jdbc:postgresql://identity-db:5432/identity-service-seika
IDENTITY_DB_USERNAME=postgres
IDENTITY_DB_PASSWORD=123456

# --- Profile Service ---
# [Cloud Neon DB Template]
# PROFILE_DB_URL=jdbc:postgresql://ep-proud-flower.ap-southeast-1.aws.neon.tech/seika_profile?sslmode=require&channel_binding=require
# PROFILE_DB_USERNAME=neondb_owner
# PROFILE_DB_PASSWORD=cloud_password
PROFILE_DB_NAME=profile-service-seika
PROFILE_DB_URL=jdbc:postgresql://profile-db:5432/profile-service-seika
PROFILE_DB_USERNAME=postgres
PROFILE_DB_PASSWORD=123456
PROFILE_DB_SCHEMA=public

# --- Wallet Service ---
# [Cloud Supabase Template]
# WALLET_DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
# WALLET_DB_USERNAME=postgres.username
# WALLET_DB_PASSWORD=cloud_password
WALLET_DB_URL=jdbc:postgresql://wallet-db:5432/wallet-service-seika
WALLET_DB_USERNAME=postgres
WALLET_DB_PASSWORD=123456
WALLET_DB_SCHEMA=public

# --- Marketplace Service ---
MARKETPLACE_DB_URL=jdbc:postgresql://marketplace-db:5432/marketplace-service-seika
MARKETPLACE_DB_USERNAME=postgres
MARKETPLACE_DB_PASSWORD=123456
MARKETPLACE_DB_SCHEMA=public

# --- Reward Service ---
REWARD_DB_URL=jdbc:postgresql://reward-db:5432/reward-service-seika
REWARD_DB_USERNAME=postgres
REWARD_DB_PASSWORD=123456
REWARD_DB_SCHEMA=public

# ---------------------------------------------------------------------
# 7. NOSQL DATABASES - MONGODB (LOCAL REPLICA SET vs MONGODB ATLAS)
# ---------------------------------------------------------------------
# --- Flashcard Service ---
# [Cloud MongoDB Atlas Template]
# FLASHCARD_DB_URI=mongodb+srv://user:password@cluster0.mongodb.net/flashcard_db?retryWrites=true&w=majority
FLASHCARD_DB_URI=mongodb://mongo:27017/flashcard-service-seika?replicaSet=rs0
FLASHCARD_DB_DATABASE=flashcard-service-seika

# --- Quiz Service ---
QUIZ_DB_URI=mongodb://mongo:27017/quiz-service-seika?replicaSet=rs0
QUIZ_DB_DATABASE=quiz-service-seika

# --- Notification Service ---
# [Cloud MongoDB Atlas Template]
# NOTIFICATION_MONGO_URI=mongodb+srv://user:password@cluster.uzazm3w.mongodb.net/seika_notification
NOTIFICATION_MONGO_URI=mongodb://mongo:27017/notification-service-seika?replicaSet=rs0
NOTIFICATION_MONGO_DATABASE=notification-service-seika

# ---------------------------------------------------------------------
# 8. MICROSERVICES INTERNAL URLS & PORTS
# ---------------------------------------------------------------------
# Dùng cho giao tiếp nội bộ giữa các microservices (Rest Client / Feign / WebClient)
IDENTITY_SERVER_URL=http://identity-service:8081
IDENTITY_SERVER_PORT=8081

PROFILE_SERVER_URL=http://profile-service:8082
PROFILE_SERVER_PORT=8082

NOTIFICATION_SERVER_URL=http://notification-service:8083
NOTIFICATION_SERVER_PORT=8083

WALLET_SERVER_URL=http://wallet-service:8084
WALLET_SERVER_PORT=8084

MARKETPLACE_SERVER_URL=http://marketplace-service:8085
MARKETPLACE_SERVER_PORT=8085

FLASHCARD_SERVER_PORT=8086
QUIZ_SERVER_PORT=8087

REWARD_SERVER_URL=http://reward-service:8088
REWARD_SERVER_PORT=8088

# ---------------------------------------------------------------------
# 9. ACTIVE SPRING PROFILE
# ---------------------------------------------------------------------
# Chọn profile chạy ứng dụng: 'dev' (mặc định cho local) hoặc 'prod' (cho production)
SPRING_PROFILE=dev

# ---------------------------------------------------------------------
# 10. CORS CONFIGURATION
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173